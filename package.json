{
  "name": "dsh-labrador",
  "version": "0.1.0",
  "description": "A Labrador that lives in the corner of the DeepSeek Harness window: cut-out photographs of one dog, driven by a small state machine, with poking, dragging, throwing, dog noises and its own settings page.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "assets/frames",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tools/machine.test.mjs && node tools/host.test.mjs && node tools/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "desktop-pet",
    "pet",
    "labrador"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laym0nd/dsh-labrador.git"
  },
  "homepage": "https://github.com/laym0nd/dsh-labrador#readme",
  "bugs": {
    "url": "https://github.com/laym0nd/dsh-labrador/issues"
  },
  "engines": {
    "dsh": ">=0.1.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1",
    "react": "^18.2.0"
  }
}
